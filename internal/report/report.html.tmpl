<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Galahad report</title>
<style>
:root{color-scheme:light dark;--bg:#fff;--fg:#1b1f24;--muted:#59636e;--line:#d0d7de;--clean:#1a7f37;--suspicious:#9a6700;--malicious:#cf222e}
@media (prefers-color-scheme:dark){:root{--bg:#0d1117;--fg:#e6edf3;--muted:#9198a1;--line:#30363d;--clean:#3fb950;--suspicious:#d29922;--malicious:#f85149}}
body{background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,sans-serif;margin:0 auto;max-width:1100px;padding:16px}
h1,h2{line-height:1.2}
.banner{border-left:8px solid var(--line);padding:8px 16px;margin-bottom:24px}
.banner.clean{border-color:var(--clean)}.banner.suspicious{border-color:var(--suspicious)}.banner.malicious{border-color:var(--malicious)}
.verdict{font-size:28px;font-weight:700;text-transform:uppercase}
.muted{color:var(--muted)}
table{border-collapse:collapse;width:100%}
.scroll{overflow-x:auto}
.warn{font-weight:700;color:var(--suspicious)}
th,td{border:1px solid var(--line);padding:4px 8px;text-align:left;vertical-align:top}
code{font-family:ui-monospace,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all}
.sev{font-weight:700;text-transform:uppercase}
.sev-critical,.sev-high{color:var(--malicious)}.sev-medium{color:var(--suspicious)}.sev-low,.sev-info,.sev-unknown{color:var(--muted)}
</style>
</head>
<body>
<h1>Galahad report</h1>
<div class="banner {{.VerdictClass}}">
<div class="verdict">{{.Verdict}}</div>
<div>Score {{.Score}}/100, confidence {{.Confidence}}% ({{.ConfidenceLevel}})</div>
{{if .Reasons}}<ul>{{range .Reasons}}<li>{{.}}</li>{{end}}</ul>{{end}}
</div>

<h2>Target</h2>
<div class="scroll" tabindex="0" role="region" aria-label="Target">
<table>
<tbody>
<tr><th scope="row">Name</th><td>{{.TargetName}}</td></tr>
<tr><th scope="row">Kind</th><td>{{.Target.Kind}}</td></tr>
{{if .Target.SHA256}}<tr><th scope="row">SHA-256</th><td><code>{{.Target.SHA256}}</code></td></tr>
{{end}}<tr><th scope="row">Size</th><td>{{.Target.Size}}</td></tr>
</tbody>
</table>
</div>

<h2>Findings ({{len .Findings}})</h2>
{{if .Findings}}<div class="scroll" tabindex="0" role="region" aria-label="Findings">
<table>
<thead><tr><th scope="col">Severity</th><th scope="col">Rule</th><th scope="col">Title</th><th scope="col">ATT&amp;CK</th><th scope="col">Location</th><th scope="col">Snippet</th></tr></thead>
<tbody>
{{range .Findings}}<tr><td class="sev sev-{{.Severity}}">{{.Severity}}</td><td>{{.Rule}}</td><td>{{.Title}}</td><td>{{.Attack}}</td><td><code>{{.Location}}</code></td><td><code>{{.Snippet}}</code></td></tr>
{{end}}</tbody>
</table>
</div>{{else}}<p class="muted">None.</p>{{end}}

<h2>Auto-execution inventory ({{len .AutoExec}})</h2>
{{if .AutoExec}}<div class="scroll" tabindex="0" role="region" aria-label="Auto-execution inventory">
<table>
<thead><tr><th scope="col">Severity</th><th scope="col">Rule</th><th scope="col">Title</th><th scope="col">Location</th><th scope="col">Snippet</th></tr></thead>
<tbody>
{{range .AutoExec}}<tr><td class="sev sev-{{.Severity}}">{{.Severity}}</td><td>{{.Rule}}</td><td>{{.Title}}</td><td><code>{{.Location}}</code></td><td><code>{{.Snippet}}</code></td></tr>
{{end}}</tbody>
</table>
</div>{{else}}<p class="muted">None.</p>{{end}}

<h2>IOCs ({{len .IOCs}})</h2>
<p class="muted">Defanged: not clickable, safe to copy into a ticket.</p>
{{if .IOCs}}<div class="scroll" tabindex="0" role="region" aria-label="IOCs">
<table>
<thead><tr><th scope="col">Type</th><th scope="col">Value</th><th scope="col">Location</th></tr></thead>
<tbody>
{{range .IOCs}}<tr><td>{{.Type}}</td><td><code>{{.Value}}</code></td><td><code>{{.Location}}</code></td></tr>
{{end}}</tbody>
</table>
</div>{{else}}<p class="muted">None.</p>{{end}}

<h2>Coverage</h2>
<p>{{.CoverageLine}}.{{if .Truncated}} The file or finding limit was reached.{{end}}</p>
{{if .CoverageWarning}}<p class="warn">{{.CoverageWarning}}.</p>{{end}}
{{if .Skips}}<div class="scroll" tabindex="0" role="region" aria-label="Skipped items">
<table>
<thead><tr><th scope="col">Skipped</th><th scope="col">Reason</th></tr></thead>
<tbody>
{{range .Skips}}<tr><td><code>{{.Path}}</code></td><td>{{.Reason}}</td></tr>
{{end}}</tbody>
</table>
</div>{{else}}<p class="muted">Nothing skipped.</p>{{end}}
</body>
</html>
